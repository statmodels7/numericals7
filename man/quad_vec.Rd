range(quad_vec(f, lower = 0, upper = rep(Inf, 30)) - 1)

# Their means, against the closed form.
g <- function(x, i) x * dgamma(x, shape = shp[i], rate = 1)
range(quad_vec(g, 0, rep(Inf, 30)) - shp)

